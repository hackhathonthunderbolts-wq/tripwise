# TripWise environment configuration
#
# Every integration used by TripWise is intentionally key-less and runs directly
# from the browser (OpenStreetMap Nominatim, Overpass API, Wikipedia/Wikimedia,
# Open-Meteo and the public OSRM demo server). No secret is required.
#
# The variables below are OPTIONAL. Leave them empty to use the public default
# endpoints. They exist so the app can be pointed at self-hosted or commercial
# deployments without touching code, and to make the API surface explicit.

# Optional: custom Overpass API endpoint tried before the public mirrors.
# Example: https://my-overpass.example.com/api/interpreter
VITE_OVERPASS_ENDPOINT=

# Optional: custom OSRM routing server used for travel-time estimates.
# Example: https://routing.openstreetmap.de/routed-foot
VITE_OSRM_ENDPOINT=

# Optional: contact e-mail added to the Nominatim request policy (referrer hint).
# Example: you@example.com
VITE_NOMINATIM_EMAIL=

# NOTE: Never commit real credentials. If you later add a keyed provider
# (Geoapify, OpenTripMap, Mapbox, Supabase), keep the secret server-side and
# expose it through a serverless proxy instead of a VITE_ variable.
